# Alpha Ticker — configuration
#
# Copy to .env for local work. On Render these go in the service's
# Environment tab. .env is gitignored; never commit real keys.

# ---------------------------------------------------------------------------
# SEC
# ---------------------------------------------------------------------------
# The SEC asks every client to identify itself with a contact address, and
# throttles traffic that does not. Use a real address you monitor.
SEC_CONTACT=you@example.com

# ---------------------------------------------------------------------------
# Supabase — Alpha Ticker project (etembhwwbqswzcepfhxp)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://etembhwwbqswzcepfhxp.supabase.co

# PUBLIC. Ships in the browser, safe in the repo and in a public page.
# Reaches only the four RPC functions; the ledger schema is unexposed.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV0ZW1iaHd3YnFzd3pjZXBmaHhwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU1NjM1MDEsImV4cCI6MjEwMTEzOTUwMX0.LpaWoQxaF0Xl0FPRq7nK7aDi7Wr_hMelnPtXJzO3y9Y

# SECRET. Bypasses RLS entirely — it is the write path for the ingest worker.
# Render environment variable only. Never in the repo, never in a browser,
# never pasted into a chat. If it leaks, rotate it in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Ingest worker
# ---------------------------------------------------------------------------
# Stay under the SEC's 10 req/s. This is a global budget for the whole
# service, which is why exactly one worker process may talk to the SEC.
SEC_MAX_RPS=8

# How often to drain the backfill queue, and how long a company's filing list
# is trusted before we re-check it against the SEC.
BACKFILL_POLL_SECONDS=20
COMPANY_RECHECK_HOURS=6

# ---------------------------------------------------------------------------
# PostHog product analytics (browser)
# ---------------------------------------------------------------------------
# Public API key and ingest host. Same arrangement as GA/Clarity: public/config.js
# (posthogApiKey / posthogHost) is what the browser reads, and these are
# build-time overrides injected by build.sh. Required in Cloudflare Pages env vars.
# POSTHOG_API_KEY=
# POSTHOG_HOST=

# ---------------------------------------------------------------------------
# Microsoft Clarity (browser analytics)
# ---------------------------------------------------------------------------
# Public project ID. Prefer public/config.js (clarityProjectId) — that is what
# the browser reads. CLARITY_PROJECT_ID is only an optional build-time override
# in build.sh (e.g. Cloudflare Pages). Not needed on Render or as a GitHub secret.
# CLARITY_PROJECT_ID=

# ---------------------------------------------------------------------------
# Google Analytics 4 (browser analytics)
# ---------------------------------------------------------------------------
# Public measurement ID (G-…), the same arrangement as Clarity: public/config.js
# (gaMeasurementId) is what the browser reads, and GA_MEASUREMENT_ID is only an
# optional build-time override in build.sh. Note this is the measurement ID, not
# the GT-… tag ID — that one belongs to a Google Tag container this site does
# not use, and installing one alongside gtag.js double-counts every page view.
# GA_MEASUREMENT_ID=

# SECRET. Measurement Protocol API secret, from Admin → Data streams →
# Ticker Alpha → Measurement Protocol API secrets. Server-side only, for events
# that happen with no browser present — a subscription renewal charged by the
# billing provider. Never in public/config.js and never in the browser.
# GA_API_SECRET=

# ---------------------------------------------------------------------------
# Market data (Financial Modeling Prep)
# ---------------------------------------------------------------------------
# Paid secret. Powers prices, movers, heatmap, and news — never the SEC
# filings. The browser never sees this key; only the Render worker does.
# FMP_API_KEY=

# FMP does NOT provide Fear & Greed or a total-US-market-cap figure.
# Fear & Greed is fetched by the worker from CNN's public index and cached
# in Supabase (migration 0015). Coverage market cap is summed from the
# heatmap universe we already store.
